.env
data/
__pycache__/
MCP_API.txt
static/dist/
static/

# git worktree の実体（node_modules と別チェックアウトを含むため追跡しない）
.claude/worktrees/

# 物差しの出力。**作者の記録の本文を含む**のでリポジトリに入れない（scripts/eval_weekly.py）。
# 入れるのは cases.json（いつ押したかの日付だけ）
.claude/hillclimb/*/baseline/
.claude/hillclimb/*/v[0-9]*/
.claude/hillclimb/*/blind*
.claude/hillclimb/*/picks.json
.claude/hillclimb/*/report.html
.claude/hillclimb/*/state.json
.claude/hillclimb/*/trajectory/

# Windows の `> nul` リダイレクトで生成されるゴミファイル
nul
.superpowers/
# フック出力がコンソールごとダンプされたもの。
# 末尾にマシン名が付く場合があるため前方一致で無視する（例: _ul-LAPTOP-XXXX）
_ul*

# 鍵。**間違って入れたら取り消せない。**
#
# `.p8` は App Store Connect が**1回しか渡してくれない**。
# 公開のリポジトリに入ると、取り消して発行し直すしかなくなる。
# `.env` と同じ扱いにする。
*.p8
AuthKey_*
*.p12
*.cer
*.mobileprovision

# App Store のスクリーンショット。**28MB ある。**
# 作り直せるものは置かない（scripts/build_store_frames.py）。
screenshots/
design-export
