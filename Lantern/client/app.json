{
  "expo": {
    "name": "Lantern",
    "slug": "lantern",
    "version": "1.0.0",
    "scheme": "lantern",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pillowhiro.lantern",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ja",
        "CFBundleLocalizations": ["ja"]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pillowhiro.lantern",
      "adaptiveIcon": {
        "backgroundColor": "#181F2F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "記録に添える写真を選ぶために使います。選んだ写真だけが保存され、AIには渡されません。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#faf9f7",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#1c1c1e"
          }
        }
      ],
      "expo-font",
      "./plugins/withoutPushEntitlement",
      "./plugins/withJournalingSuggestions"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "04815106-2180-4a87-b6e7-a17eb558d470"
      }
    },
    "owner": "pillow_hiro",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/04815106-2180-4a87-b6e7-a17eb558d470"
    }
  }
}
